+/**
+ * Converts a string into a URL-friendly slug.
+ *
+ * @param input - The string to slugify.
+ * @returns A lowercase, hyphen-separated string with non-alphanumeric characters removed.
+ * @example slugify("Hello World!") // "hello-world"
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Truncates a string to a maximum length, appending an ellipsis if truncated.
+ *
+ * @param input - The string to truncate.
+ * @param max - The maximum length of the result.
+ * @returns The truncated string; if truncated, a single "…" is appended so the result length equals `max`.
+ * @example truncate("hello world", 5) // "hell…"
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Extracts the initials from a person's name.
+ *
+ * @param name - The full name to process.
+ * @returns The initials in uppercase, formed from the first character of each whitespace-separated word.
+ * @example initials("Jane Doe") // "JD"
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
