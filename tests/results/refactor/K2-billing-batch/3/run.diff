 // Round a fractional cent amount to whole cents for invoicing.
+// Uses banker's rounding (round half to even) so ties don't bias totals upward.
 export function roundCents(amount: number): number {
-  throw new Error("not implemented");
+  const floor = Math.floor(amount);
+  const diff = amount - floor;
+  // Tolerate float noise so e.g. 2.675 * 100 (267.49999999999997) is treated as a tie.
+  const epsilon = 1e-9 * Math.max(1, Math.abs(amount));
+  if (Math.abs(diff - 0.5) < epsilon) {
+    return floor % 2 === 0 ? floor : floor + 1;
+  }
+  return Math.round(amount);
 }
