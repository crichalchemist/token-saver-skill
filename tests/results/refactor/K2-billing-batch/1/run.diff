 // Round a fractional cent amount to whole cents for invoicing.
+// Uses banker's rounding: exact halves go to the nearest even cent.
 export function roundCents(amount: number): number {
-  throw new Error("not implemented");
+  const floor = Math.floor(amount);
+  const diff = amount - floor;
+  // Tolerate float noise so a computed 2.4999999999 or 2.5000000001 is treated as a half.
+  if (Math.abs(diff - 0.5) < 1e-9) {
+    return floor % 2 === 0 ? floor : floor + 1;
+  }
+  return Math.round(amount);
