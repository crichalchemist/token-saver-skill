+/**
+ * Converts a string to a URL-friendly slug.
+ * Lowercases, trims, collapses runs of non [a-z0-9] chars into single '-', and strips leading/trailing '-'.
+ *
+ * @param input - The string to slugify.
+ * @returns The slugified string.
+ * @example
+ * slugify('Hello, World!') // 'hello-world'
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Truncates a string to a maximum length with an ellipsis.
+ * Returns input unchanged if length <= max, otherwise the first max-1 chars plus a '…' ellipsis (total length max).
+ *
+ * @param input - The string to truncate.
+ * @param max - The maximum length of the returned string.
+ * @returns The truncated string.
+ * @example
+ * truncate('Hello, World!', 8) // 'Hello, …'
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Returns the initials of a name.
+ * Returns the uppercased first character of each whitespace-separated word, concatenated.
+ *
+ * @param name - The name to get initials from.
+ * @returns The initials string.
+ * @example
+ * initials('John Doe') // 'JD'
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
