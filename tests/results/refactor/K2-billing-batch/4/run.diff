+/**
+ * Converts an input string to a URL-friendly slug.
+ *
+ * @param {string} input - The string to convert to a slug.
+ * @returns {string} The slugified string where all non-[a-z0-9] runs are collapsed into "-",
+ * and leading and trailing dashes are stripped.
+ * @example
+ * slugify("Hello, World!"); // "hello-world"
+ * slugify("  JavaScript & TypeScript  "); // "javascript-typescript"
+ * slugify("   ---   "); // ""
+ * slugify("café_au_lait"); // "caf-au-lait"
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Truncates a string to a specified maximum length.
+ *
+ * @param {string} input - The string to truncate.
+ * @param {number} max - The maximum length of the returned string.
+ * @returns {string} The truncated string where, if `input.length > max`, it appends a single "…" character
+ * and the result length is `max`; otherwise returns the original string.
+ * @example
+ * truncate("Hello World", 5); // "Hell…"
+ * truncate("Hello", 5); // "Hello"
+ * truncate("Hi", 1); // "…"
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Extracts the initials from a person's name.
+ *
+ * @param {string} name - The name to extract initials from.
+ * @returns {string} A string containing the uppercase first character of each whitespace-separated word.
+ * @example
+ * initials("John Doe"); // "JD"
+ * initials("  Jane   Smith   "); // "JS"
+ * initials("Alice"); // "A"
+ * initials("  "); // ""
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
