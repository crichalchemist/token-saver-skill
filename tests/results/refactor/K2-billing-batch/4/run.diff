 // Round a fractional cent amount to whole cents for invoicing.
+// Uses banker's rounding (round half to even) so exact .5 ties don't bias totals upward.
 export function roundCents(amount: number): number {
-  throw new Error("not implemented");
+  if (!Number.isFinite(amount)) {
+    throw new RangeError(`roundCents: amount must be finite, got ${amount}`);
+  }
+  const floor = Math.floor(amount);
+  const diff = amount - floor;
+  if (diff < 0.5) return floor;
+  if (diff > 0.5) return floor + 1;
+  return floor % 2 === 0 ? floor : floor + 1;
 }
