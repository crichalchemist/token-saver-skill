+/**
+ * Lowercases the input, trims whitespace, collapses runs of non [a-z0-9] characters into a single '-',
+ * and strips leading and trailing '-'.
+ * @param input - The string to slugify.
+ * @returns The slugified string.
+ * @example slugify(" Hello, World!  Foo--Bar ") // "hello-world-foo-bar"
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Returns the input unchanged if its length <= max; otherwise returns the first max-1 characters plus '…'
+ * so the result length is max.
+ * @param input - The string to truncate.
+ * @param max - The maximum length of the result string.
+ * @returns The truncated string.
+ * @example truncate("Hello, World!", 6) // "Hello…"
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Takes the first character of each whitespace-separated word, uppercased, and joined.
+ * @param name - The name to extract initials from.
+ * @returns The uppercase initials string.
+ * @example initials("John Doe") // "JD"
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
