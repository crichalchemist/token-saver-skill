+/**
+ * Converts arbitrary text into a lowercase, hyphen-separated URL slug.
+ *
+ * @param input - Text to convert. Runs of characters outside `a-z0-9` collapse
+ *   into single hyphens, which are trimmed from both ends.
+ * @returns The slug, never with a leading or trailing hyphen.
+ *
+ * @example
+ * slugify("Q3 Revenue & Growth"); // "q3-revenue-growth"
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens text to at most `max` characters, replacing the cut with an ellipsis.
+ *
+ * @param input - Text to shorten.
+ * @param max - Maximum length of the result, the ellipsis included.
+ * @returns `input` unchanged when it already fits in `max`, otherwise its first
+ *   `max - 1` characters followed by "…".
+ *
+ * @example
+ * truncate("hello world", 5); // "hell…"
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds uppercase initials from a person's name, ignoring extra whitespace.
+ *
+ * @param name - Full name to abbreviate.
+ * @returns The uppercase first letter of each whitespace-separated word.
+ *
+ * @example
+ * initials("  jean   luc  picard "); // "JLP"
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
