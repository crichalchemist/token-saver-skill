+/**
+ * Converts a string into a URL-friendly slug.
+ *
+ * Lowercases and trims the input, collapses every run of characters outside
+ * `[a-z0-9]` into a single `-`, then strips leading and trailing `-`.
+ *
+ * @param input - The string to convert.
+ * @returns The slug form of `input`.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens a string to at most `max` characters.
+ *
+ * Returns `input` unchanged when `input.length <= max`. Otherwise returns the
+ * first `max - 1` characters followed by `…`, so the result is exactly `max`
+ * characters long.
+ *
+ * @param input - The string to truncate.
+ * @param max - The maximum length of the returned string.
+ * @returns `input` unchanged if `input.length <= max`, otherwise the first
+ * `max - 1` characters of `input` plus `…`.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Extracts the initials from a name.
+ *
+ * Splits `name` on whitespace, discards empty tokens, takes the first
+ * character of each token, and uppercases it. The initials are concatenated
+ * together.
+ *
+ * @param name - The name to extract initials from.
+ * @returns The concatenated uppercase initials.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
