+/**
+ * Converts text to a URL-safe slug: lowercases and trims it, replaces each run
+ * of characters outside `[a-z0-9]` with a single `-`, then strips leading and
+ * trailing `-`.
+ *
+ * @param input The text to slugify.
+ * @returns The slugified text, e.g. `"Hello, World!"` becomes `"hello-world"`.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens text to at most `max` characters, using an ellipsis to mark the cut.
+ *
+ * @param input The text to truncate.
+ * @param max The maximum length of the returned string.
+ * @returns `input` unchanged when its length is `<= max`; otherwise the first
+ * `max - 1` characters followed by `"…"`, for a total length of `max`.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds initials from a name by taking the uppercased first character of each
+ * whitespace-separated word and joining them.
+ *
+ * @param name The name to abbreviate.
+ * @returns The joined initials, e.g. `"ada lovelace"` becomes `"AL"`.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
