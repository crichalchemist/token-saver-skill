+/**
+ * Converts a string into a URL-friendly slug.
+ * @param input The string to slugify.
+ * @returns The lowercased and trimmed string with each run of non-alphanumeric characters replaced by a single "-", and any leading or trailing "-" removed.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens a string to a maximum length using an ellipsis.
+ * @param input The string to truncate.
+ * @param max The maximum length of the returned string.
+ * @returns The input unchanged when its length is at most max, otherwise its first max - 1 characters followed by "…", so the result is max characters long.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds the uppercase initials from a person's name.
+ * @param name The name to take initials from, split on whitespace.
+ * @returns The uppercased first character of each non-empty whitespace-separated part, concatenated.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
