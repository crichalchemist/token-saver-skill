+// Tolerance for treating float noise around .5 as an exact tie.
+const TIE_EPSILON = 1e-9;
+
 // Round a fractional cent amount to whole cents for invoicing.
+// Uses banker's rounding: exact half cents go to the nearest even cent.
 export function roundCents(amount: number): number {
-  throw new Error("not implemented");
+  const floor = Math.floor(amount);
+  if (Math.abs(amount - floor - 0.5) < TIE_EPSILON) {
+    return floor % 2 === 0 ? floor : floor + 1;
+  }
+  return Math.round(amount);
