+/**
+ * Converts a string into a lowercase, URL-safe slug.
+ * Runs of non-alphanumeric characters become a single hyphen; leading and
+ * trailing hyphens are removed. Non-ASCII letters are stripped, not transliterated.
+ * @param input - The text to slugify.
+ * @returns The slug, e.g. `"  Hello, World! "` → `"hello-world"`.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens a string to at most `max` characters, ending with an ellipsis (`…`) when cut.
+ * @param input - The text to truncate.
+ * @param max - Maximum length of the result, including the ellipsis.
+ * @returns `input` unchanged if it fits, otherwise the first `max - 1` characters plus `…`.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds uppercase initials from the whitespace-separated words of a name.
+ * @param name - A full name, e.g. `"ada  lovelace"`.
+ * @returns The initials, e.g. `"AL"`; an empty string if `name` has no words.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
