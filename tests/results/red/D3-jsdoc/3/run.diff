+/**
+ * Converts a string into a URL-friendly slug.
+ *
+ * Lowercases and trims the input, collapses each run of non-alphanumeric
+ * characters into a single hyphen, and strips leading/trailing hyphens.
+ *
+ * @param input - The string to slugify.
+ * @returns The slugified string, e.g. `"Hello, World!"` → `"hello-world"`.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens a string to at most `max` characters, appending an ellipsis (`…`)
+ * when truncation occurs.
+ *
+ * @param input - The string to truncate.
+ * @param max - Maximum length of the result, including the ellipsis.
+ * @returns The original string if it fits within `max`, otherwise the first
+ *   `max - 1` characters followed by `…`.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds uppercase initials from a whitespace-separated name.
+ *
+ * @param name - The full name, e.g. `"ada lovelace"`.
+ * @returns The first character of each word, uppercased and joined,
+ *   e.g. `"AL"`. Returns an empty string for blank input.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
