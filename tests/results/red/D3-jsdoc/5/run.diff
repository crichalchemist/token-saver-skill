+/**
+ * Converts a string into a URL-friendly slug.
+ *
+ * Lowercases and trims the input, collapses every run of characters outside
+ * `a-z0-9` into a single hyphen, and strips leading/trailing hyphens.
+ * Non-ASCII letters (e.g. accented characters) are treated as separators.
+ *
+ * @param input - The string to slugify.
+ * @returns The slug, e.g. `"Hello, World!"` → `"hello-world"`.
+ */
 export function slugify(input: string): string {
   return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
 }
 
+/**
+ * Shortens a string to at most `max` characters, ending with an ellipsis if cut.
+ *
+ * The ellipsis (`…`) counts toward `max`, so a truncated result is exactly
+ * `max` characters long. Strings already within the limit are returned unchanged.
+ *
+ * @param input - The string to truncate.
+ * @param max - Maximum length of the returned string.
+ * @returns The original string, or its first `max - 1` characters followed by `…`.
+ */
 export function truncate(input: string, max: number): string {
   return input.length <= max ? input : input.slice(0, max - 1) + "…";
 }
 
+/**
+ * Builds uppercase initials from a whitespace-separated name.
+ *
+ * @param name - A full name, e.g. `"ada  lovelace"`.
+ * @returns The first character of each word, uppercased, e.g. `"AL"`.
+ *   Returns an empty string for blank input.
+ */
 export function initials(name: string): string {
   return name.split(/\s+/).filter(Boolean).map((p) => p[0]!.toUpperCase()).join("");
 }
